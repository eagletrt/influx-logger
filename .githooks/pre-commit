#!/usr/bin/env bash

# Exit immediately if a command fails unexpectedly
set -e

# 1. Check if yapf and pylint are installed
MISSING_TOOLS=0

if ! command -v yapf &> /dev/null; then
    echo "❌ Error: 'yapf' is not installed."
    MISSING_TOOLS=1
fi

if ! command -v pylint &> /dev/null; then
    echo "❌ Error: 'pylint' is not installed."
    MISSING_TOOLS=1
fi

if [ "$MISSING_TOOLS" -ne 0 ]; then
    echo "💡 Please install missing tools using: pip install yapf pylint"
    exit 1
fi

# 2. Run yapf code formatting
echo "🧹 Running yapf auto-formatter..."
yapf --in-place --parallel --recursive src/*

# Re-stage formatted files so changes are included in the current commit
git add src/

# 3. Run pylint and verify score >= 9.5
echo "🔍 Running pylint..."

# Disable 'set -e' temporarily so script doesn't abort on pylint exit codes > 0
set +e
PYLINT_OUTPUT=$(pylint -r y src)
set -e

echo "$PYLINT_OUTPUT"

# Extract score from output line: "Your code has been rated at X.XX/10"
SCORE=$(echo "$PYLINT_OUTPUT" | awk -F'rated at ' '/rated at/ {split($2, a, "/"); print a[1]}')

if [ -z "$SCORE" ]; then
    echo "❌ Error: Could not determine pylint score."
    exit 1
fi

# Check if score >= 9.5 using Python
PASSED=$(python3 -c "import sys; print(1 if float(sys.argv[1]) >= 9.5 else 0)" "$SCORE")

if [ "$PASSED" -eq 1 ]; then
    echo "✅ Pylint score is $SCORE/10 (Threshold >= 9.5). Commit allowed!"
    exit 0
else
    echo "❌ Commit rejected: Pylint score ($SCORE) is below the required 9.5 threshold."
    exit 1
fi
