#!/usr/bin/env bash
set -euo pipefail

SRC="src"

# Use local tools if available
if command -v ruff &> /dev/null && command -v yapf &> /dev/null && command -v pylint &> /dev/null; then
    echo "Running checks using local Python tools..."
    .githooks/check.sh
    git add $SRC
    exit 0
fi

# Use Docker
if command -v docker &> /dev/null; then
    echo "Local tools not found."
    echo "Running checks inside Docker..."
    # Build with Docker's cache so changes to the Dockerfile are picked up.
    docker build -t repo-linter -f .githooks/Dockerfile.lint .
    # Mount repo root, install dependencies, and execute check.sh
    docker run --rm -v "$(pwd)":/workspace -w /workspace repo-linter bash .githooks/check.sh
    # Re-stage files formatted by yapf inside Docker
    git add $SRC
    exit 0
fi

# No tool available
echo "Error: Missing required tools (ruff, yapf, pylint) and Docker is not running."
exit 1
